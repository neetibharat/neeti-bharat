
# ============================================================
# Neeti Bharat — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://neeti:neeti@localhost:5440/neeti
POSTGRES_PASSWORD=neeti

# Optional: Prisma migration validation database.
# Must point to an empty database that Prisma can safely reset.
# SHADOW_DATABASE_URL=postgresql://neeti:neeti@localhost:5440/neeti_shadow


# ------------------------------------------------------------
# API & Web
# ------------------------------------------------------------

API_PORT=3201
WEB_ORIGIN=http://localhost:3200
API_URL=http://localhost:3201


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars

# First account allowed to claim admin access in production.
# Leave empty in development (first user becomes admin).
INITIAL_ADMIN_EMAIL=


# ------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------

# Leave SMTP_HOST empty in development to log sign-in links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ------------------------------------------------------------
# OAuth Providers (Optional)
# ------------------------------------------------------------

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Register these redirect URIs with the respective providers:
# Google:    <WEB_ORIGIN>/api/auth/callback/google
# Microsoft: <WEB_ORIGIN>/api/auth/callback/microsoft
#
# MICROSOFT_TENANT_ID:
# - common: Accept personal and organisational Microsoft accounts.
# - <tenant-id>: Restrict authentication to a specific organisation.


# ------------------------------------------------------------
# Secrets (Optional — needed for Connections)
# ------------------------------------------------------------

# Seals the credentials of connections, such as an Azure app registration, so a copy of the database alone does
# not give them away. 32 random bytes in base64: openssl rand -base64 32
# Leave it empty and Connections cannot keep credentials. Keep it safe: values sealed with it cannot be read without it.
SECRETS_ENCRYPTION_KEY=

# ------------------------------------------------------------
# AI help (Optional — one AI service for the whole install)
# ------------------------------------------------------------

# Leave all three empty and AI help is off. Set AI_PROVIDER and AI_API_KEY together; an admin then turns the features
# on under Settings, AI help. The text a feature needs is sent to this service with this key.
# AI_PROVIDER is openai, anthropic or deepseek. AI_MODEL is the model's exact name: optional for anthropic and
# deepseek, required for openai.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# ------------------------------------------------------------
# File Storage (Optional — S3 compatible, or Azure Blob Storage below)
# ------------------------------------------------------------

# Leave STORAGE_BUCKET empty to disable uploads.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Use both storage credentials or neither (default AWS credentials).
# STORAGE_ENDPOINT must be browser-accessible for private file downloads.
# Downloads use signed URLs valid for 5 minutes.

# Azure Blob Storage, instead of the S3 settings above. Set these three together and leave STORAGE_BUCKET empty.
# AZURE_STORAGE_ACCOUNT is the storage account name, and AZURE_STORAGE_KEY is one of its access keys.
# Downloads use links signed with the key, valid for 5 minutes.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
# Only for the Azurite emulator, for example http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_ENDPOINT=

# MinIO development configuration (started by pnpm db:up):
#
# STORAGE_BUCKET=neeti-proof
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=neetiminio
# STORAGE_SECRET_ACCESS_KEY=neetiminio-secret
# STORAGE_FORCE_PATH_STYLE=true
