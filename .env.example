
# ============================================================
# DPDP — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://dpdp:dpdp@localhost:5440/dpdp
POSTGRES_PASSWORD=dpdp

# Optional: Prisma migration validation database.
# Must point to an empty database that Prisma can safely reset.
# SHADOW_DATABASE_URL=postgresql://dpdp:dpdp@localhost:5440/dpdp_shadow


# ------------------------------------------------------------
# API & Web
# ------------------------------------------------------------

API_PORT=3201
WEB_ORIGIN=http://localhost:3200
API_URL=http://localhost:3201


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars

# First account allowed to claim admin access in production.
# Leave empty in development (first user becomes admin).
INITIAL_ADMIN_EMAIL=


# ------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------

# Leave SMTP_HOST empty in development to log sign-in links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ------------------------------------------------------------
# OAuth Providers (Optional)
# ------------------------------------------------------------

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Register these redirect URIs with the respective providers:
# Google:    <WEB_ORIGIN>/api/auth/callback/google
# Microsoft: <WEB_ORIGIN>/api/auth/callback/microsoft
#
# MICROSOFT_TENANT_ID:
# - common: Accept personal and organisational Microsoft accounts.
# - <tenant-id>: Restrict authentication to a specific organisation.


# ------------------------------------------------------------
# File Storage (Optional — S3 Compatible)
# ------------------------------------------------------------

# Leave STORAGE_BUCKET empty to disable uploads.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Use both storage credentials or neither (default AWS credentials).
# STORAGE_ENDPOINT must be browser-accessible for private file downloads.
# Downloads use signed URLs valid for 5 minutes.

# MinIO development configuration (started by pnpm db:up):
#
# STORAGE_BUCKET=dpdp-proof
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=dpdpminio
# STORAGE_SECRET_ACCESS_KEY=dpdpminio-secret
# STORAGE_FORCE_PATH_STYLE=true
