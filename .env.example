# API
# The password must match POSTGRES_PASSWORD below (docker compose uses it when it first creates the database).
DATABASE_URL=postgresql://dpdp:dpdp@localhost:5440/dpdp
POSTGRES_PASSWORD=dpdp
# An empty database that Prisma tooling may reset, to check that migrations match the schema. Not read by the API.
# SHADOW_DATABASE_URL=postgresql://dpdp:dpdp@localhost:5440/dpdp_shadow
API_PORT=3201
WEB_ORIGIN=http://localhost:3200
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars

# The only email that may claim a new install (it becomes the first admin). Required in production.
# Leave empty in development: the first person to sign in becomes the admin.
INITIAL_ADMIN_EMAIL=

# Email for sign-in links. Leave SMTP_HOST empty in development: links are printed to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Google and Microsoft sign-in. Set both values of a pair to switch it on.
# Redirect URI to register with each provider: <WEB_ORIGIN>/api/auth/callback/google (or /microsoft)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts any Microsoft account; use your tenant id to allow only your organisation.
MICROSOFT_TENANT_ID=common

# Optional: file storage for proof, any S3-compatible service. Leave STORAGE_BUCKET empty to switch uploads off.
# Set both keys, or neither to use the default AWS credentials. Uploads are private; downloads use 5-minute links,
# so STORAGE_ENDPOINT must also be reachable from people's browsers.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# Only for services other than AWS S3, such as MinIO or Cloudflare R2.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for MinIO.
STORAGE_FORCE_PATH_STYLE=false
# For the MinIO that `pnpm db:up` starts, use these values in place of the ones above (compose reads the keys and bucket too):
# STORAGE_BUCKET=dpdp-proof
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=dpdpminio
# STORAGE_SECRET_ACCESS_KEY=dpdpminio-secret
# STORAGE_FORCE_PATH_STYLE=true

# Web: where the web server forwards /api and /v1 requests. Read by the web app only; the API ignores it.
API_URL=http://localhost:3201
