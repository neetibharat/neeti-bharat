{
  "name": "@neeti-bharat/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "MCP server that lets Claude set up a company's Neeti Bharat through its API",
  "type": "module",
  "bin": {
    "neeti-bharat-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "mcpb": "pnpm bundle && node scripts/pack.mjs"
  },
  "dependencies": {
    "@neeti-bharat/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@anthropic-ai/mcpb": "^2.1.2"
  }
}
